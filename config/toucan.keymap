#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define NUM  5

/ {
    behaviors {
        lp_cpy: long_press_copy {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        hyper_meh: hyper_meh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(LA(LGUI)))>, <&kp LS(LC(LALT))>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td_slash_caps: td_slash_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp FSLH>, <&kp CAPS>;
        };

    };

    combos {
        compatible = "zmk,combos";

        combo_esc_df {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp ESC>;
        };

        combo_esc_jk {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp TAB &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC  &kp LEFT_CONTROL  &hrm LCTRL A  &hrm LALT S  &hrm LGUI D  &hrm LSHFT F  &lt 4 G  &kp H  &hrm RSHFT J  &hrm RGUI K  &hrm RALT L  &hrm RCTRL SEMI  &kp SQT  &hyper_meh  &lt NUM Z  &kp X  &lp_cpy LG(C) C  &lp_cpy LG(V) V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &td_slash_caps  &sk RSHFT  &kp LGUI  &mo 1  &kp SPACE  &kp RET  &mo 2  &mo 3
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&kp TAB  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp BSPC  &kp MINUS  &trans  &trans  &trans  &trans  &kp PG_DN  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &kp DEL  &kp LSHFT  &trans  &kp LC(LS(TAB))  &kp LG(LS(RBKT))  &kp LG(GRAVE)  &kp RA(GRAVE)  &kp LG(LEFT_ARROW)  &kp RG(RIGHT_ARROW)  &kp LA(LEFT_ARROW)  &kp RA(RIGHT_ARROW)  &kp LC(LA(LG(M)))  &kp LC(LG(N))  &kp LGUI  &trans  &kp SPACE  &kp RET  &trans  &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&kp TAB  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC  &kp LCTRL  &trans  &trans  &trans  &trans  &trans  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE  &kp LSHFT  &trans  &trans  &trans  &trans  &trans  &kp PLUS  &kp UNDER  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE  &kp LGUI  &trans  &kp SPACE  &kp RET  &trans  &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
&kp LG(LA(ESC))  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp C_BRI_DN  &kp C_BRI_UP  &kp BSPC  &kp LCTRL  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp LC(LG(Q))  &kp C_VOICE_COMMAND  &kp LG(LA(LC(LS(K))))  &kp LA(SPACE)  &trans  &bt BT_CLR  &bt BT_CLR_ALL  &kp F11  &kp F12  &kp LA(TAB)  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &kp LGUI  &mo 1  &kp SPACE  &kp RET  &mo 2  &kp RALT
            >;
        };

        g_layer {
            display-name = "G Layer";

            // Source F-Nav compressed onto Toucan:
            //
            // Toucan top-left  = source top row:  ⇧⌘←  ↑  ↓  ⇧⌘→
            // Toucan top-right = source 2nd row:  ⇧⌥←  ⇧⌥→  ⌘⇧V(mac plain)  ⌘⌥⇧V(mac match)
            // Toucan mid-left  = row ops:         sel-row  del-row  ins-excel  ins-proj
            // Toucan mid-right = source 3rd row:  ⌥←   ⌥→   ⌃⇧V(win plain)  ⌃⌥V(win special)
            // Toucan low-right = source 4th row:  ⌘←   ⌘→

            bindings = <
&trans  &kp LS(LG(LEFT))  &kp UP  &kp DOWN  &kp LS(LG(RIGHT))  &trans  &kp LS(LA(LEFT))  &kp LS(LA(RIGHT))  &kp LG(LS(V))  &kp LG(LA(LS(V)))  &trans  &trans  &trans  &kp LS(SPACE)  &kp LC(KP_MINUS)  &kp LC(KP_PLUS)  &kp INS  &trans  &kp LA(LEFT)  &kp LA(RIGHT)  &kp LC(LS(V))  &kp LC(LA(V))  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LG(LEFT)  &kp LG(RIGHT)  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        num_pad {
            display-name = "NUM";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp MINUS  &kp N7  &kp N8  &kp N9  &trans  &kp BSPC  &trans  &trans  &trans  &trans  &trans  &trans  &kp PLUS  &kp N4  &kp N5  &kp N6  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N0  &kp N1  &kp N2  &kp N3  &kp N0  &trans  &trans  &trans  &trans  &kp RET  &trans  &trans
            >;
        };

        extra_3 { status = "reserved"; };
    };
};
